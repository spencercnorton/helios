#!/usr/bin/env python3
"""Native stdio proxy; never put diagnostics on the MCP stdout stream."""
import sys
from pathlib import Path

_src = Path(__file__).resolve().parents[1] / "src"
if (_src / "helios").is_dir():
    sys.path.insert(0, str(_src))
from helios.backend.estate_setup import proxy_main  # noqa: E402

raise SystemExit(proxy_main())
