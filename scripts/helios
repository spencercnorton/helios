#!/usr/bin/env bash
# Helios — launcher. Run from anywhere; resolves paths relative to install.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HELIOS_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

export PYTHONPATH="${HELIOS_ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}"
exec python3 -m helios "$@"
